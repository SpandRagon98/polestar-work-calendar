# Supabase project settings → API. Both values are public (safe in the browser).
# Never put the service-role / secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: URL name of the invite Edge Function if not deployed as "invite-user".
# VITE_INVITE_FUNCTION=invite-user
